  <PropertyGroup Label="UserMacros" />
  <!-- The game loads every asset and sound by a path relative to the
       working directory ("Assets/Player/l1.png", "gamebgm.mp3", ...) and
       needs GLUT32.DLL beside it. All of that lives in the project
       folder, so the .exe is built there too. Building it into a
       separate Release\ folder is what stopped it starting: the loader
       could not find GLUT32.DLL, and nothing would have loaded even if
       it had. Only the intermediate files go into Release\. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)</OutDir>
    <IntDir>$(ProjectDir)Release\</IntDir>
  </PropertyGroup>
